# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LOG_FILE=gemini_telemetry.log

# PostgreSQL + pgvector Configuration (Local Docker or AWS Aurora PostgreSQL)
POSTGRES_USER=dba_admin
POSTGRES_PASSWORD=your_chosen_strong_password
POSTGRES_DB=consensus_db
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

